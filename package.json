{
  "name": "researchledger",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest --run",
    "lint": "tsc --noEmit",
    "tauri": "tauri",
    "linkedin:capture": "node scripts/linkedin_capture.mjs",
    "reddit:capture": "node scripts/reddit_capture.mjs",
    "x:capture": "node scripts/x_capture.mjs",
    "hackernews:capture": "node scripts/hackernews_capture.mjs",
    "verify:resources": "node scripts/verify_resources.mjs",
    "postinstall": "node ./scripts/postinstall.mjs",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "typecheck:tsgo": "tsgo --noEmit -p tsconfig.json",
    "typecheck:experimental": "bun run typecheck:tsgo"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^26.0.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.0",
    "vite": "^8.2.1",
    "vitest": "^3.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2"
  }
}
