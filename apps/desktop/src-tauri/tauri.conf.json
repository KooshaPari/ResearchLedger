{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResearchLedger",
  "version": "0.1.0",
  "identifier": "com.phenotype.researchledger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ResearchLedger",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/researchledger.icns"] }
}
